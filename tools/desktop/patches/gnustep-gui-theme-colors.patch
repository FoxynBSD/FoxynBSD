+  /* Theme resources may be installed read-only.  Keep a mutable system
+   * list in memory so missing defaults and later user overrides do not
+   * attempt to edit the theme's color file.
+   */
+  if (list != defaultSystemColors && [list isEditable] == NO)
+    {
+      NSColorList *mutableList = AUTORELEASE([[NSColorList alloc]
+        initWithName: @"System"]);
+      enumerator = [[list allKeys] objectEnumerator];
+      while ((key = [enumerator nextObject]) != nil)
+        {
+          [mutableList setColor: [list colorWithKey: key] forKey: key];
+        }
+      list = mutableList;
+    }
+
