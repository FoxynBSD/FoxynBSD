#!/bin/sh
#
# foxyn-desktop: install the interim FoxynBSD graphical desktop from DPorts
# on a writable root, and start it at boot (issue #13).
#
# Usage: foxyn-desktop [-loy] [-g source|dports] [-m mirror] [-u user]
#		[-w gershwin|twm]
#
#	-l	start Gershwin's LoginWindow at boot (foxyn_loginwindow,
#		needs -g source) instead of the desktop user's session
#		(foxyn_desktop); the user then logs in with their password
#	-o	run the desktop user's session from OpenRC (needs -g source,
#		not with -l): build OpenRC (build-openrc.sh), install the
#		services dbus (the system bus) and foxyn-desktop (the
#		session, after dbus) in its "desktop" runlevel, and enable
#		the foxyn_openrc rc.d service, which starts that runlevel at
#		boot, instead of foxyn_desktop
#	-y	do not ask for confirmation
#	-g	where GNUstep comes from: source (default) builds Make,
#		libobjc2, Base, GUI and Back from the revisions pinned by
#		contrib/gnustep-* (build-gnustep.sh, as the desktop user)
#		and installs them in /System, Gershwin's layout, with
#		Gershwin's Menu (build-menu.sh); dports
#		installs DPorts' older GNUstep in /usr/local/GNUstep.
#	-m	DPorts mirror URL instead of pkg's default, e.g.
#		https://mirror.sjtu.edu.cn/dragonflybsd/dports
#	-u	the desktop user (default: foxyn); created without a password
#		when it does not exist, like root on the test images
#	-w	the window manager: gershwin (default) builds Gershwin's
#		WindowManager from its pinned source as the desktop user
#		(build-windowmanager.sh, with the llvm19 compiler from
#		DPorts) and installs it with GNUstep's applications; twm
#		skips that.  twm is installed either way, and the session
#		falls back to it when WindowManager is missing.
#
# It installs X with the scfb driver (the EFI framebuffer through
# syscons; no KMS), libinput, fonts, GNUstep, twm and xterm, and
# enables the foxyn_desktop rc.d service: at boot, root starts X with a
# fresh MIT-MAGIC-COOKIE and no TCP listener, and the desktop user's
# ~/.xsession runs as that user.  When the session ends, X stops and the
# console login remains.  `service foxyn_desktop stop` ends it too, and
# foxyn_desktop_enable=NO in rc.conf turns it off (the recovery path).
#
# This is the stopgap until the Gershwin session (contrib/gershwin-*)
# is built in base: it needs the internet, the packages are DPorts', and
# the Gershwin Workspace, Menu and session supervisor are not installed.

set -eu

user=foxyn
mirror=
yes=0
wm=gershwin
gnustep=source
login=0
openrc=0
usage="usage: foxyn-desktop [-loy] [-g source|dports] [-m mirror] [-u user] [-w gershwin|twm]"
while getopts g:lm:ou:w:y opt; do
	case $opt in
	l)	login=1 ;;
	o)	openrc=1 ;;
	g)	gnustep=$OPTARG ;;
	m)	mirror=$OPTARG ;;
	u)	user=$OPTARG ;;
	w)	wm=$OPTARG ;;
	y)	yes=1 ;;
	*)	echo "$usage" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || { echo "$usage" >&2; exit 2; }
case $wm in gershwin|twm) ;; *) echo "$usage" >&2; exit 2 ;; esac
case $gnustep in source|dports) ;; *) echo "$usage" >&2; exit 2 ;; esac
[ "$login" = 0 ] || [ "$gnustep" = source ] || { echo "$usage" >&2; exit 2; }
[ "$openrc" = 0 ] || { [ "$gnustep" = source ] && [ "$login" = 0 ]; } ||
    { echo "$usage" >&2; exit 2; }
# The build-*.sh helpers and their patches, installed by
# tools/linux/build.sh.
share=/usr/share/foxynbsd/desktop

say() { echo "foxyn-desktop: $*"; }
die() { echo "foxyn-desktop: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "must run as root"
case $user in
''|root|*[!a-z0-9_-]*) die "bad user name: $user" ;;
esac
touch /.foxyn-desktop-rw 2>/dev/null && rm -f /.foxyn-desktop-rw ||
    die "the root file system is read-only: install on a disk first"
if [ "$yes" = 0 ]; then
	printf 'Install X11, GNUstep and a graphical session for %s from DPorts? [y/N] ' "$user"
	read -r answer
	case $answer in [yY]*) ;; *) die "cancelled" ;; esac
fi

log=/var/log/foxyn-desktop.log
: > "$log"
if [ ! -x /usr/local/sbin/pkg ]; then
	say "bootstrapping pkg(8)"
	make -C /usr pkg-bootstrap >> "$log" 2>&1 || die "pkg bootstrap failed (see $log)"
fi
if [ -n "$mirror" ]; then
	mkdir -p /usr/local/etc/pkg/repos
	printf 'Avalon: { url: "%s/${ABI}/LATEST" }\n' "$mirror" \
	    > /usr/local/etc/pkg/repos/df-latest.conf
	pkg update -f >> "$log" 2>&1 || die "pkg update failed (see $log)"
fi
pkgs="xorg-minimal xf86-video-scfb xf86-input-libinput dejavu font-misc-misc
    font-alias xauth xinput xwininfo xsetroot xterm twm"
if [ "$gnustep" = dports ]; then
	pkgs="$pkgs gnustep gnustep-sudoku"
	gsroot=/usr/local/GNUstep
	apps=$gsroot/Local/Applications
else
	# What GNUstep Make, Base, GUI and Back build and link with (DPorts'
	# GNUstep's dependencies), dbus and gettext for Menu, the compiler,
	# what XLibre builds with, xdotool for the login window test
	# (boot-test.sh --desktop), and what PipeWire and WirePlumber build
	# and run with (jackd, the sound server PipeWire plays through).
	pkgs="$pkgs gmake llvm19 pkgconf cmake-core ninja libxml2 libxslt
	    libffi gnutls icu curl avahi-app gmp libgcrypt cups giflib
	    jpeg-turbo png tiff libsndfile libao flite cairo fontconfig
	    freetype2 libXcursor libXext libXfixes libXft libXmu libXrender
	    libXt libglvnd dbus gettext-runtime sqlite3
	    meson autoconf automake libtool xorg-macros pixman libxkbfile
	    libXfont2 libxcvt libxshmfence libdrm libpciaccess xorgproto xtrans
	    libXau libXdmcp font-util libinput libepoll-shim libXrandr
	    libXinerama xkbcomp xkeyboard-config evdev-proto xdotool
	    jackit libinotify glib lua54 libsndfile readline"
	gsroot=
	apps=/System/Applications
	# Its libraries have DPorts' names (libobjc.so.4.6): not both.
	pkg info -e libobjc2 &&
	    die "DPorts' GNUstep is installed: pkg delete libobjc2, or use -g dports"
fi
gnustep_sh=$gsroot/System/Library/Makefiles/GNUstep.sh
[ "$wm" = gershwin ] && pkgs="$pkgs gmake llvm19 pkgconf xcb-util xcb-util-wm
    xcb-util-cursor"
say "installing $(echo $pkgs)"
pkg install -y $pkgs >> "$log" 2>&1 || {
	tail -n 5 "$log" >&2; die "pkg install failed (see $log)"; }

# Several drivers match the framebuffer, and Xorg then gives up
# ("Cannot run in framebuffer mode"): name scfb.
mkdir -p /usr/local/etc/X11/xorg.conf.d
printf 'Section "Device"\n\tIdentifier "fb"\n\tDriver "scfb"\nEndSection\n' \
    > /usr/local/etc/X11/xorg.conf.d/10-scfb.conf

if ! id "$user" >/dev/null 2>&1; then
	pw useradd -n "$user" -c "FoxynBSD desktop" -m -s /bin/sh -w none ||
	    die "cannot create $user"
	say "created user $user (no password)"
fi
home=$(pw usershow "$user" | cut -d: -f9)
[ -d "$home" ] || die "$user has no home directory: $home"

# build_as WHAT SCRIPT ARGS: run a build helper as the desktop user (not
# root) in a directory of their own.  su -m runs the command with root's
# shell, csh on the full image.
build_as()
{
	what=$1; shift
	say "building $what as $user"
	su -m "$user" -c "cd '$work' && env HOME='$home' GNUSTEP_SH='$gnustep_sh' sh $*" \
	    >> "$log" 2>&1 || { tail -n 5 "$log" >&2; rm -rf "$work"
		die "$what build failed (see $log)"; }
}
# install_app BUNDLE: install a bundle built in $work root-owned in $apps.
install_app()
{
	mkdir -p "$apps"
	rm -rf "${apps:?}/$1"
	cp -R "$work/$1" "$apps/$1"
	chown -R root:wheel "$apps/$1"
	chmod -R go-w "$apps/$1"
	say "installed $apps/$1"
}

# GNUstep and Gershwin's Menu from the pinned sources, built and
# installed in /System by the desktop user; /System is root's again
# when they are done (or failed).
system_root()
{
	chown -R root:wheel /System
	chmod -R go-w /System
}
# build_system WHAT SCRIPT: run a helper that installs in /System.
build_system()
{
	say "building $1 as $user"
	work=$(mktemp -d /tmp/foxyn-system.XXXXXXXX) || die "mktemp failed"
	chown "$user" "$work"
	su -m "$user" -c "cd '$work' && env HOME='$home' TMPDIR='$work' sh '$share/$2'" \
	    >> "$log" 2>&1 || { tail -n 5 "$log" >&2; system_root
		rm -rf "$work"; die "$1 build failed (see $log)"; }
	rm -rf "$work"
}
if [ "$gnustep" = source ]; then
	for f in build-gnustep.sh build-menu.sh build-systempreferences.sh \
	    build-workspace.sh build-eau.sh install-gershwin-system.sh \
	    build-xlibre.sh build-pipewire.sh; do
		[ -r "$share/$f" ] || die "$share/$f is missing"
	done
	mkdir -p /System
	chown -R "$user" /System
	if [ ! -e /System/Library/Libraries/libgnustep-gui.so ]; then
		build_system GNUstep build-gnustep.sh
		say "installed GNUstep in /System"
	fi
	if [ ! -x /System/Library/CoreServices/Applications/Menu.app/Menu ] ||
	    [ ! -x /System/Library/Tools/gershwin-session ] ||
	    [ ! -x /System/Library/CoreServices/Applications/LoginWindow.app/LoginWindow ]; then
		build_system "Gershwin Menu" build-menu.sh
		say "installed /System/Library/CoreServices/Applications/Menu.app"
	fi
	# Before Workspace, which needs its PreferencePanes framework.
	if [ ! -x /System/Applications/SystemPreferences.app/SystemPreferences ]; then
		build_system "Gershwin System Preferences" build-systempreferences.sh
		say "installed /System/Applications/SystemPreferences.app"
	fi
	# The X server: XLibre from contrib/xlibre (DPorts' Xorg stays
	# installed as the fallback the session uses without it).
	if [ ! -x /System/Library/XLibre/bin/X ]; then
		build_system XLibre build-xlibre.sh
		say "installed /System/Library/XLibre"
	fi
	# Sound: PipeWire and WirePlumber from contrib/pipewire and
	# contrib/wireplumber.
	if [ ! -x /System/Library/PipeWire/bin/pipewire ]; then
		build_system PipeWire build-pipewire.sh
		say "installed /System/Library/PipeWire"
	fi
	mkdir -p /System/Library/XLibre/etc/X11/xorg.conf.d
	cp /usr/local/etc/X11/xorg.conf.d/10-scfb.conf /System/Library/XLibre/etc/X11/xorg.conf.d/
	if [ ! -x /System/Applications/Workspace.app/Workspace ]; then
		build_system "Gershwin Workspace" build-workspace.sh
		say "installed /System/Applications/Workspace.app"
	fi
	# Gershwin's look: the Eau theme, and its system-wide GNUstep
	# defaults (GSTheme=Eau, fonts), fonts and desktop pictures.
	if [ ! -d /System/Library/Themes/Eau.theme ]; then
		build_system "Gershwin Eau theme" build-eau.sh
		say "installed /System/Library/Themes/Eau.theme"
	fi
	if [ ! -d /System/Library/Preferences/GlobalDefaults ] ||
	    [ ! -x /System/Library/Scripts/Gershwin.sh ]; then
		build_system "Gershwin's defaults and fonts" install-gershwin-system.sh
		say "installed /System/Library/Preferences and Fonts"
	fi
	# Gershwin's fonts.conf (/System/Library/Fonts) next to the
	# system's fonts, not instead of them.
	mkdir -p /usr/local/etc/fonts/conf.d
	printf '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig>\n  <include ignore_missing="yes">/System/Library/Preferences/fonts.conf</include>\n</fontconfig>\n' \
	    > /usr/local/etc/fonts/conf.d/60-gershwin.conf
	system_root
	# gershwin-session finds the apps it supervises on $PATH, which
	# Gershwin.sh and the session start with /System/Library/Tools
	# (WindowManager without compositing: no GL here).
	# GNUstep Make already links Workspace and Menu there (to the
	# applications' executables: never write through those links).
	gwbin=/System/Library/Tools
	rm -rf "$gwbin/Gershwin" "$gwbin/WindowManager"
	printf '#!/bin/sh\nexec /System/Applications/WindowManager.app/WindowManager -dc "$@"\n' \
	    > "$gwbin/WindowManager"
	chmod 555 "$gwbin/WindowManager"
	[ -e "$gwbin/Workspace" ] ||
	    ln -s ../../Applications/Workspace.app/Workspace "$gwbin/Workspace"
	[ -e "$gwbin/Menu" ] ||
	    ln -s ../CoreServices/Applications/Menu.app/Menu "$gwbin/Menu"
	# PipeWire plays through its JACK tunnel (no OSS backend) and starts
	# WirePlumber; foxyn-audio starts jackd first.
	pwconf=/System/Library/PipeWire/etc/pipewire/pipewire.conf.d
	mkdir -p "$pwconf"
	cat > "$pwconf/10-foxyn.conf" <<'EOF'
# FoxynBSD (foxyn-desktop): sound through jackd on OSS (a JACK sink, and
# a JACK source when the card records), and the session manager.
context.modules = [
  { name = libpipewire-module-jack-tunnel
    args = { tunnel.mode = duplex } }
]
context.exec = [
  { path = "/System/Library/PipeWire/bin/wireplumber" args = "" }
]
EOF
	chmod -R go-w /System/Library/PipeWire/etc
fi

# Gershwin's WindowManager, and (with GNUstep from source, which has no
# Sudoku) TextEdit as the session's first application.
wmapp=$apps/WindowManager.app
if [ "$wm" = gershwin ] && [ ! -x "$wmapp/WindowManager" ]; then
	[ -r "$share/build-windowmanager.sh" ] ||
	    die "$share/build-windowmanager.sh is missing"
	work=$(mktemp -d /tmp/foxyn-wm.XXXXXXXX) || die "mktemp failed"
	chown "$user" "$work"
	build_as "Gershwin WindowManager" "'$share/build-windowmanager.sh' '$work/WindowManager.app'"
	install_app WindowManager.app
	rm -rf "$work"
fi
if [ "$gnustep" = source ] && [ ! -x "$apps/TextEdit.app/TextEdit" ]; then
	[ -r "$share/build-textedit.sh" ] || die "$share/build-textedit.sh is missing"
	work=$(mktemp -d /tmp/foxyn-te.XXXXXXXX) || die "mktemp failed"
	chown "$user" "$work"
	build_as "Gershwin TextEdit" "'$share/build-textedit.sh' '$work/TextEdit.app'"
	install_app TextEdit.app
	rm -rf "$work"
fi
if [ ! -e "$home/.xsession" ]; then
	cat > "$home/.xsession" <<'EOF'
#!/bin/sh
# The FoxynBSD interim desktop session (foxyn-desktop(8)); the session
# ends when the window manager does: Gershwin's WindowManager when it is
# installed, else twm (its menu: Log out).  GNUstep is in /System when
# built from source (foxyn-desktop -g source), else DPorts'.
if [ -r /System/Library/Makefiles/GNUstep.sh ]; then
	gs=/System/Library/Makefiles/GNUstep.sh apps=/System/Applications
	app=$apps/TextEdit.app/TextEdit
else
	gs=/usr/local/GNUstep/System/Library/Makefiles/GNUstep.sh
	apps=/usr/local/GNUstep/Local/Applications
	app=/usr/local/GNUstep/System/Applications/Sudoku.app/Sudoku
fi
. "$gs"
xsetroot -solid '#3a6ea5'
cat > "$HOME/.twmrc" <<TWM
BorderWidth 2
TitleFont "-misc-fixed-bold-r-normal--13-*-*-*-*-*-iso8859-1"
MenuFont "-misc-fixed-medium-r-normal--13-*-*-*-*-*-iso8859-1"
IconFont "-misc-fixed-medium-r-normal--13-*-*-*-*-*-iso8859-1"
RandomPlacement
Button1 = : root : f.menu "FoxynBSD"
menu "FoxynBSD" {
	"FoxynBSD"	f.title
	"Terminal"	f.exec "exec xterm -fa 'DejaVu Sans Mono' -fs 11 &"
	"GNUstep"	f.exec "exec $app &"
	""		f.nop
	"Log out"	f.quit
}
TWM
# Gershwin's session (as its Library/Scripts/Gershwin.sh): the supervisor
# runs Workspace, Menu and WindowManager, restarts them when they exit,
# and ends the session when Menu's Log Out signals it.
if [ -x /System/Library/Tools/gershwin-session ] &&
    [ -x /System/Library/Tools/Workspace ]; then
	PATH=/System/Library/Tools:$PATH
	export PATH
	[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || eval "$(dbus-launch --sh-syntax --exit-with-x11)"
	[ -x /usr/local/libexec/foxyn-audio ] && /usr/local/libexec/foxyn-audio &
	(sleep 6; exec "$app") &
	(sleep 9; exec xterm -fa 'DejaVu Sans Mono' -fs 11 -geometry 80x24+40+60 -title Terminal) &
	exec gershwin-session Workspace Menu WindowManager
fi
# The window manager first: clients mapped before it starts are not
# redrawn when twm reparents them.  -dc: no compositing (no GL here).
wmapp=$apps/WindowManager.app
if [ -x "$wmapp/WindowManager" ]; then
	"$wmapp/WindowManager" -dc &
else
	twm &
fi
wm=$!
sleep 1
# Gershwin's global menu bar, when GNUstep was built from source.
menu=/System/Library/CoreServices/Applications/Menu.app/Menu
[ -x "$menu" ] && "$menu" &
"$app" &
# An xterm mapped while the GNUstep application starts stays blank (seen
# under QEMU with scfb; cause not found): start it a little later.
sleep 3
xterm -fa 'DejaVu Sans Mono' -fs 11 -geometry 80x24+40+60 -title Terminal &
wait "$wm"
EOF
	chown "$user" "$home/.xsession"
	chmod 755 "$home/.xsession"
fi

mkdir -p /usr/local/libexec /usr/local/etc/rc.d
cat > /usr/local/libexec/foxyn-xinput <<'EOF'
#!/bin/sh
# Input for XLibre, which has no devd hotplug backend: an xorg.conf.d
# file with the keyboard multiplexer (every keyboard, hotplugged ones
# too) and the mice found now.  Opening a keyboard's own node would take
# it away from kbdmux; with rcpt_mask 6 the keyboards report through
# kbdmux and the mice through their own nodes.  Run as root before X.
xl=/System/Library/XLibre
sysctl -q kern.evdev.rcpt_mask=6
{
printf 'Section "ServerFlags"\n\tOption "AutoAddDevices" "false"\nEndSection\n'
layout=
n=0
while [ "$n" -lt 64 ]; do
	phys=$(sysctl -n kern.evdev.input.$n.phys 2>/dev/null) ||
	    { n=$((n + 1)); continue; }
	case $phys in
	kbdmux0) ;;
	sysmouse|*kbd[0-9]*) n=$((n + 1)); continue ;;
	esac
	if [ -c /dev/input/event$n ]; then
		printf 'Section "InputDevice"\n\tIdentifier "event%s"\n\tDriver "libinput"\n\tOption "Device" "/dev/input/event%s"\nEndSection\n' $n $n
		layout="$layout	InputDevice \"event$n\"
"
	fi
	n=$((n + 1))
done
printf 'Section "Screen"\n\tIdentifier "screen"\n\tDevice "fb"\nEndSection\n'
printf 'Section "ServerLayout"\n\tIdentifier "layout"\n\tScreen "screen"\n%sEndSection\n' "$layout"
} > $xl/etc/X11/xorg.conf.d/20-input.conf
EOF
chmod 555 /usr/local/libexec/foxyn-xinput
cat > /usr/local/libexec/foxyn-audio <<'EOF'
#!/bin/sh
# The desktop session's sound, as its user: jackd on the first OSS device
# (/dev/dsp: playback and recording, or playback only when the card does
# not record), then PipeWire, which plays and records through its JACK
# tunnel and starts WirePlumber.  Nothing without PipeWire or a sound
# card.  Logs in $XDG_RUNTIME_DIR.
# Why there is no sound goes to the session's log (stderr): the logs in
# $XDG_RUNTIME_DIR go away with the session.
pw=/System/Library/PipeWire
[ -x $pw/bin/pipewire ] || exit 0
[ -c /dev/dsp ] || { echo "foxyn-audio: no sound card (/dev/dsp)" >&2; exit 0; }
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] ||
    { echo "foxyn-audio: no XDG_RUNTIME_DIR" >&2; exit 1; }
PATH=$pw/bin:/usr/local/bin:/usr/bin:/bin
export PATH
for inputs in 2 0; do
	if [ "$inputs" = 2 ]; then
		set -- -C /dev/dsp -P /dev/dsp
	else
		set -- -P /dev/dsp
	fi
	jackd -d oss -r 48000 -p 1024 -n 2 -i "$inputs" -o 2 "$@" \
	    > "$XDG_RUNTIME_DIR/jackd.log" 2>&1 &
	jack=$!
	# Up: still running after 10 s without a driver error.  (Opening
	# a card that cannot record can take a few seconds to fail.)
	i=0
	while [ "$i" -lt 10 ]; do
		if ! kill -0 "$jack" 2>/dev/null ||
		    grep -q 'Cannot initialize driver\|Failed to open server' \
		    "$XDG_RUNTIME_DIR/jackd.log"; then
			kill "$jack" 2>/dev/null
			wait "$jack" 2>/dev/null
			jack=
			break
		fi
		sleep 1; i=$((i + 1))
	done
	[ -n "$jack" ] && break
done
if [ -z "$jack" ]; then
	echo "foxyn-audio: jackd did not start:" >&2
	tail -n 5 "$XDG_RUNTIME_DIR/jackd.log" >&2
	exit 1
fi
echo "foxyn-audio: jackd runs with $inputs inputs; starting PipeWire" >&2
pipewire > "$XDG_RUNTIME_DIR/pipewire.log" 2>&1 ||
    { echo "foxyn-audio: pipewire exited with $?:" >&2; tail -n 5 "$XDG_RUNTIME_DIR/pipewire.log" >&2; }
kill "$jack" 2>/dev/null
EOF
chmod 555 /usr/local/libexec/foxyn-audio
cat > /usr/local/libexec/foxyn-session <<'EOF'
#!/bin/sh
# Run X as root on vt9 with a fresh cookie and the desktop user's
# ~/.xsession as that user; stop X when the session ends.  -noreset:
# otherwise X resets (and forgets the root window's colour) whenever its
# last client disconnects, e.g. after xsetroot.  rc.d's PATH
# has no /usr/local: X and xauth are there.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH
user=$1
exec >> /var/log/foxyn-session.log 2>&1
# The cookie stays in this directory: the server's copy root's, the
# user's copy theirs (the directory can be searched, not listed).
auth=$(mktemp -d /tmp/foxyn-session.XXXXXXXX) || exit 1
chmod 711 "$auth"
umask 077
cookie=$(openssl rand -hex 16) || exit 1
xauth -q -f "$auth/server" add :0 MIT-MAGIC-COOKIE-1 "$cookie" || exit 1
xauth -q -f "$auth/user" add :0 MIT-MAGIC-COOKIE-1 "$cookie" || exit 1
unset cookie
chown "$user" "$auth/user" || exit 1
echo "$auth/user" > /var/run/foxyn-session.xauthority
# The user's runtime directory (XDG): PipeWire's sockets.
uid=$(id -u "$user") || exit 1
rt=/var/run/user/$uid
mkdir -p -m 755 /var/run/user
rm -rf "$rt"
mkdir -m 700 "$rt" && chown "$user" "$rt" || exit 1
# XLibre, when foxyn-desktop built it, else DPorts' Xorg.
xl=/System/Library/XLibre
if [ -x $xl/bin/X ]; then
	/usr/local/libexec/foxyn-xinput
	# XLibre removed -noreset (it does not reset when clients leave).
	$xl/bin/X :0 -nolisten tcp -auth "$auth/server" vt9 > /var/log/foxyn-session.X.log 2>&1 &
else
	X :0 -nolisten tcp -noreset -auth "$auth/server" vt9 > /var/log/foxyn-session.X.log 2>&1 &
fi
xpid=$!
echo "$xpid" > /var/run/foxyn-session.X.pid
i=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
if ! kill -0 "$xpid" 2>/dev/null || [ ! -S /tmp/.X11-unix/X0 ]; then
	echo "X did not start (see /var/log/foxyn-session.X.log); no session"
	kill "$xpid" 2>/dev/null
	rm -rf "$auth" "$rt" /var/run/foxyn-session.X.pid /var/run/foxyn-session.xauthority
	exit 1
fi
echo "session for $user started"
su -l "$user" -c "DISPLAY=:0 XAUTHORITY=$auth/user XDG_RUNTIME_DIR=$rt exec \$HOME/.xsession" &
spid=$!
# Gershwin's supervisor does not notice that X went away (it would
# restart its applications for ever): when X exits first, end the
# session as Log Out does.
while kill -0 "$spid" 2>/dev/null; do
	# (again each second: the supervisor may not have started yet)
	kill -0 "$xpid" 2>/dev/null ||
	    pkill -TERM -u "$user" -x gershwin-session
	sleep 1
done
wait "$spid"
echo "session for $user ended: $?"
kill "$xpid" 2>/dev/null
wait "$xpid"
# GNUstep's per-user daemons, Workspace's helpers and the sound servers
# outlive the session's clients; wait (up to 10 s) for them to exit.
daemons='gdnc|gpbs|ddbd|fswatcher|pipewire|wireplumber|jackd'
pkill -u "$user" -x "$daemons"
i=0
while pgrep -u "$user" -x "$daemons" >/dev/null && [ "$i" -lt 10 ]; do
	sleep 1; i=$((i + 1))
done
# Then anything else of the user's, as LoginWindow does at logout: an
# application that did not exit with X (TextEdit, started by .xsession,
# was seen to outlive the session) would hold on into the next one.
if pgrep -u "$user" >/dev/null; then
	echo "ending what remains of $user's session: $(pgrep -u "$user" -l | tr '\n' ' ')"
	pkill -TERM -u "$user"
	i=0
	while pgrep -u "$user" >/dev/null && [ "$i" -lt 5 ]; do
		sleep 1; i=$((i + 1))
	done
	pkill -KILL -u "$user"
fi
rm -rf "$auth" "$rt" /var/run/foxyn-session.X.pid /var/run/foxyn-session.xauthority
EOF
chmod 555 /usr/local/libexec/foxyn-session
cat > /usr/local/etc/rc.d/foxyn_desktop <<'EOF'
#!/bin/sh
#
# PROVIDE: foxyn_desktop
# REQUIRE: LOGIN devd
# KEYWORD: shutdown

. /etc/rc.subr

name=foxyn_desktop
rcvar=foxyn_desktop_enable
load_rc_config $name
: ${foxyn_desktop_enable:=NO}
: ${foxyn_desktop_user:=foxyn}
pidfile=/var/run/foxyn-session.pid
extra_commands=status
start_cmd=foxyn_desktop_start
stop_cmd=foxyn_desktop_stop
status_cmd=foxyn_desktop_status

foxyn_desktop_running()
{
	[ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

foxyn_desktop_start()
{
	foxyn_desktop_running && { echo "$name is already running."; return 0; }
	echo "Starting $name."
	/usr/sbin/daemon -f -p "$pidfile" \
	    /usr/local/libexec/foxyn-session "$foxyn_desktop_user"
}

foxyn_desktop_stop()
{
	foxyn_desktop_running || { echo "$name is not running."; return 0; }
	echo "Stopping $name."
	# End Gershwin's session as Log Out does, and X; foxyn-session then
	# cleans up and exits.
	pkill -TERM -u "$foxyn_desktop_user" -x gershwin-session
	[ -f /var/run/foxyn-session.X.pid ] &&
	    kill "$(cat /var/run/foxyn-session.X.pid)" 2>/dev/null
	i=0
	while foxyn_desktop_running && [ "$i" -lt 20 ]; do
		sleep 1; i=$((i + 1))
	done
	foxyn_desktop_running && kill "$(cat "$pidfile")" 2>/dev/null
	rm -f "$pidfile"
}

foxyn_desktop_status()
{
	if foxyn_desktop_running; then
		echo "$name is running as pid $(cat "$pidfile")."
	else
		echo "$name is not running."; return 1
	fi
}

run_rc_command "$1"
EOF
chmod 555 /usr/local/etc/rc.d/foxyn_desktop
# Gershwin's LoginWindow as the display manager: it starts X (XLibre,
# which its patched search path finds first), authenticates through
# PAM's "login" service and runs /System/Library/Scripts/Gershwin.sh as
# the user; after Log Out it shows the login window again.
cat > /usr/local/libexec/foxyn-loginwindow <<'EOF'
#!/bin/sh
# Start X (XLibre, else DPorts' Xorg) with a fresh cookie that only root
# has, unless it already runs, then LoginWindow with that cookie; the
# patched LoginWindow gives the user who logs in access to the display
# for the session.  LoginWindow uses the running server (it looks for an
# "Xorg" process) instead of starting its own.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH
auth=/var/run/xauth
xpidf=/var/run/foxyn-loginwindow.X.pid
# Reuse only the server this script started; another one (a server that
# is still exiting after a stop, or the automatic session's) must be
# gone first.
if ! { [ -f $xpidf ] && kill -0 "$(cat $xpidf)" 2>/dev/null; }; then
	rm -f $xpidf
	i=0
	while pgrep -x Xorg >/dev/null && [ "$i" -lt 15 ]; do
		sleep 1; i=$((i + 1))
	done
	pgrep -x Xorg >/dev/null && { echo "another X server runs"; exit 1; }
	rm -f "$auth"
	# Only the cookie is private: LoginWindow inherits the umask, and
	# refuses (with an alert at every start) the preferences it writes
	# unless they are mode 0644.
	(umask 077 &&
	    xauth -q -f "$auth" add :0 MIT-MAGIC-COOKIE-1 "$(openssl rand -hex 16)") ||
	    exit 1
	if [ -x /System/Library/XLibre/bin/Xorg ]; then
		/usr/local/libexec/foxyn-xinput
		/System/Library/XLibre/bin/Xorg :0 -nolisten tcp -auth "$auth" vt9 \
		    > /var/log/foxyn-loginwindow.X.log 2>&1 &
	else
		Xorg :0 -nolisten tcp -auth "$auth" vt9 \
		    > /var/log/foxyn-loginwindow.X.log 2>&1 &
	fi
	echo $! > $xpidf
	i=0
	while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
fi
DISPLAY=:0 XAUTHORITY=$auth
export DISPLAY XAUTHORITY
. /System/Library/Makefiles/GNUstep.sh
exec /System/Library/CoreServices/Applications/LoginWindow.app/LoginWindow
EOF
chmod 555 /usr/local/libexec/foxyn-loginwindow
cat > /usr/local/etc/rc.d/foxyn_loginwindow <<'EOF'
#!/bin/sh
#
# PROVIDE: foxyn_loginwindow
# REQUIRE: LOGIN devd
# KEYWORD: shutdown

. /etc/rc.subr

name=foxyn_loginwindow
rcvar=foxyn_loginwindow_enable
load_rc_config $name
: ${foxyn_loginwindow_enable:=NO}
pidfile=/var/run/foxyn_loginwindow.pid
command=/usr/sbin/daemon
procname=/usr/sbin/daemon
command_args="-r -f -o /var/log/LoginWindow.log -P $pidfile /usr/local/libexec/foxyn-loginwindow"
stop_precmd=foxyn_loginwindow_prestop
stop_postcmd=foxyn_loginwindow_poststop

# A user's session outlives LoginWindow (its supervisor restarted the
# applications after X ended): end it as Log Out does, and give
# LoginWindow time to clean up after it.
foxyn_loginwindow_prestop()
{
	local lw i
	lw=$(pgrep -x LoginWindow) || return 0
	pkill -TERM -P "$lw" -x gershwin-session || return 0
	i=0
	while pgrep -P "$lw" -x gershwin-session >/dev/null && [ "$i" -lt 15 ]; do
		sleep 1; i=$((i + 1))
	done
	sleep 2
}

# The X server foxyn-loginwindow started outlives LoginWindow.
foxyn_loginwindow_poststop()
{
	[ -f /var/run/foxyn-loginwindow.X.pid ] &&
	    kill "$(cat /var/run/foxyn-loginwindow.X.pid)" 2>/dev/null
	rm -f /var/run/foxyn-loginwindow.X.pid /var/run/xauth
}

run_rc_command "$1"
EOF
chmod 555 /usr/local/etc/rc.d/foxyn_loginwindow

# OpenRC for the desktop's services (-o), next to init and rc.d: the
# rc.d service foxyn_openrc runs `openrc desktop` at boot, and switches
# to the empty runlevel "off" to stop them.  OpenRC keeps the services'
# state in its svcdir, on disk here: foxyn_openrc mounts a tmpfs on it
# at boot, as OpenRC's own sysinit does on FreeBSD.
if [ "$openrc" = 1 ]; then
	if [ ! -x /sbin/openrc ]; then
		[ -r "$share/build-openrc.sh" ] || die "$share/build-openrc.sh is missing"
		work=$(mktemp -d /tmp/foxyn-openrc.XXXXXXXX) || die "mktemp failed"
		chown "$user" "$work"
		build_as OpenRC "'$share/build-openrc.sh' '$work/root'"
		chown -R root:wheel "$work/root"
		chmod -R go-w "$work/root"
		# Missing directories (empty ones too: OpenRC's runlevels), then
		# the files: the system's existing directories keep their
		# owners and modes.
		(cd "$work/root" && find . -type d -print) | while read -r d; do
			[ -d "/$d" ] || mkdir -p "/$d"
		done
		(cd "$work/root" && find . ! -type d -print | cpio -pdmu / 2>> "$log") ||
		    { rm -rf "$work"; die "cannot install OpenRC"; }
		rm -rf "$work"
		# rc.d keeps the system's own services (file systems, network,
		# syslogd): no OpenRC service of its default runlevels starts.
		for r in sysinit boot default nonetwork; do
			find "/usr/local/etc/runlevels/$r" -type l -delete
		done
		say "installed OpenRC"
	fi
	initd=/usr/local/etc/init.d
	cat > $initd/dbus <<'EOF'
#!/sbin/openrc-run
# D-Bus's system bus (DPorts' dbus), for the desktop (foxyn-desktop -o).
description="D-Bus system message bus"
command=/usr/local/bin/dbus-daemon
command_args="--system --nofork --nopidfile"
command_background=yes
pidfile=/var/run/dbus/openrc.pid

start_pre()
{
	mkdir -p /var/run/dbus
	/usr/local/bin/dbus-uuidgen --ensure
	# A socket left by a bus that did not stop cleanly.
	rm -f /var/run/dbus/system_bus_socket
}
EOF
	cat > $initd/foxyn-desktop <<'EOF'
#!/sbin/openrc-run
# X and the desktop user's ~/.xsession (foxyn-session), as the rc.d
# service foxyn_desktop does; foxyn-desktop -o.
description="FoxynBSD desktop session"
: ${foxyn_desktop_user:=foxyn}
command=/usr/local/libexec/foxyn-session
command_args=$foxyn_desktop_user
command_background=yes
pidfile=/var/run/foxyn-session.openrc.pid

depend()
{
	need dbus
}

# End Gershwin's session as Log Out does, and X; foxyn-session then
# cleans up and exits (up to 20 s).
stop()
{
	ebegin "Stopping $RC_SVCNAME"
	pkill -TERM -u "$foxyn_desktop_user" -x gershwin-session
	[ -f /var/run/foxyn-session.X.pid ] &&
	    kill "$(cat /var/run/foxyn-session.X.pid)" 2>/dev/null
	pid=$(cat "$pidfile" 2>/dev/null)
	i=0
	while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
		sleep 1; i=$((i + 1))
	done
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$pidfile"
	eend 0
}
EOF
	chmod 555 $initd/dbus $initd/foxyn-desktop
	printf 'foxyn_desktop_user="%s"\n' "$user" > /usr/local/etc/conf.d/foxyn-desktop
	mkdir -p /usr/local/etc/runlevels/desktop /usr/local/etc/runlevels/off
	ln -sf $initd/dbus $initd/foxyn-desktop /usr/local/etc/runlevels/desktop/
	cat > /usr/local/etc/rc.d/foxyn_openrc <<'EOF'
#!/bin/sh
#
# PROVIDE: foxyn_openrc
# REQUIRE: LOGIN devd
# KEYWORD: shutdown

. /etc/rc.subr

name=foxyn_openrc
rcvar=foxyn_openrc_enable
load_rc_config $name
: ${foxyn_openrc_enable:=NO}
: ${foxyn_openrc_runlevel:=desktop}
extra_commands=status
start_cmd=foxyn_openrc_start
stop_cmd=foxyn_openrc_stop
status_cmd=foxyn_openrc_status
svcdir=/usr/local/libexec/rc/init.d

foxyn_openrc_start()
{
	echo "Starting OpenRC runlevel $foxyn_openrc_runlevel."
	# The services' state from before the last boot is stale.
	if [ "$(df "$svcdir" | awk 'END { print $NF }')" != "$svcdir" ]; then
		mount -t tmpfs -o rw,noexec,nosuid tmpfs "$svcdir" || return 1
	fi
	/sbin/openrc "$foxyn_openrc_runlevel"
}

foxyn_openrc_stop()
{
	echo "Stopping OpenRC services (runlevel off)."
	/sbin/openrc off
}

# Running while the session's service is.
foxyn_openrc_status()
{
	/sbin/rc-service foxyn-desktop status
}

run_rc_command "$1"
EOF
	chmod 555 /usr/local/etc/rc.d/foxyn_openrc
fi

sed -i.bak -e '/^foxyn_desktop_enable=/d' -e '/^foxyn_desktop_user=/d' \
    -e '/^foxyn_loginwindow_enable=/d' -e '/^foxyn_openrc_enable=/d' /etc/rc.conf
rm -f /etc/rc.conf.bak
if [ "$login" = 1 ]; then
	printf 'foxyn_loginwindow_enable="YES"\n' >> /etc/rc.conf
	say "done: LoginWindow starts at the next boot (or: service foxyn_loginwindow start)"
elif [ "$openrc" = 1 ]; then
	# foxyn_desktop_user stays for the boot test; OpenRC's service reads
	# its conf.d.
	printf 'foxyn_openrc_enable="YES"\nfoxyn_desktop_user="%s"\n' "$user" >> /etc/rc.conf
	say "done: OpenRC starts the desktop at the next boot (or: service foxyn_openrc start)"
else
	printf 'foxyn_desktop_enable="YES"\nfoxyn_desktop_user="%s"\n' "$user" >> /etc/rc.conf
	say "done: the desktop starts at the next boot (or: service foxyn_desktop start)"
fi
