#!/bin/sh
#
# foxyn-install: install the running FoxynBSD system on a disk.
#
# A minimal installer for the images that tools/linux/build.sh makes: it
# erases DISK, gives it a GPT with an EFI system partition and a root
# partition, copies the running system onto it and makes it boot on its
# own (EFI loader and kernel on the ESP).  Run it as root from root.iso
# or disk.img.
#
# Usage:
#	foxyn-install [-y] [-P] [-t hammer2|ufs] [-b BOOTDISK] [-s ESPSIZE] DISK
#
#	DISK		the disk to erase, as in /dev (vbd2, da0, nvme0, ...)
#	-y		do not ask before erasing DISK
#	-P		read the installed system's root password, one line, from
#			standard input (checked before anything is erased).
#			Without -P root has no password, as on the test images
#	-t		root file system: hammer2 (default) or ufs
#	-b		what the kernel will call the disk when it boots from it;
#			it goes into loader.conf and fstab.  Default: each
#			slice by its GPT unique id, slice-by-uuid/<uuid>, which
#			stays the same on any machine and bus (a disk image
#			made under QEMU, written to a USB stick, boots a PC);
#			without those names, the disk's serial number name,
#			serno/<serial>, else vbd0 (the only virtio disk under
#			QEMU)
#	-s		size of the EFI system partition in MiB (default 256)
#
# Layout: GPT slice 0 is the ESP (FAT32: EFI/BOOT/BOOTX64.EFI and /boot
# with the loader's files and the kernel), slice 1 the root.  A HAMMER2
# root gets the default DATA PFS (newfs_hammer2 on a slice).

set -eu

FSTYPE=hammer2
BOOTDISK=
ESPMB=256
YES=
ROOTPW=
SETPW=

die() { echo "foxyn-install: $*" >&2; exit 1; }
msg() { echo "foxyn-install: $*"; }
usage() { die "usage: foxyn-install [-y] [-P] [-t hammer2|ufs] [-b BOOTDISK] [-s ESPSIZE] DISK"; }

while getopts yPt:b:s: o; do
	case $o in
	y)	YES=1 ;;
	P)	SETPW=1 ;;
	t)	FSTYPE=$OPTARG ;;
	b)	BOOTDISK=$OPTARG ;;
	s)	ESPMB=$OPTARG ;;
	*)	usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
if [ -n "$SETPW" ]; then
	IFS= read -r ROOTPW || die "no root password on standard input"
	[ -n "$ROOTPW" ] || die "the root password is empty"
fi
DISK=${1#/dev/}

case $FSTYPE in hammer2|ufs) ;; *) die "-t must be hammer2 or ufs" ;; esac
case $DISK in ''|*[!A-Za-z0-9_]*) die "DISK must be a whole-disk device name" ;; esac
disks=$(sysctl -n kern.disks) || die "cannot list disks"
case " $disks " in
*" $DISK "*) ;;
*) die "/dev/$DISK is not a listed whole disk" ;;
esac
# The disk's serial number name: devfs makes /dev/serno/<serial> an
# alias, the same device (major and minor) as /dev/$DISK.  Its slices
# are <serial>.s0, ...; the whole disk is the entry without a dot.
# Only a fallback when -b is not given: the slices' GPT ids come first
# (below, once the slices exist).
BYUUID=
[ -z "$BOOTDISK" ] && BYUUID=1
if [ -z "$BOOTDISK" ]; then
	mm=$(ls -l "/dev/$DISK" | awk '{ print $5, $6 }')
	BOOTDISK=$(ls -l /dev/serno 2>/dev/null |
	    awk -v mm="$mm" '$5 " " $6 == mm && $NF !~ /\./ { print "serno/" $NF; exit }')
	: "${BOOTDISK:=vbd0}"
fi
# The slices' names: vbd0s1, or serno/<serial>.s1.
case $BOOTDISK in
serno/*) SLICE=$BOOTDISK.s ;;
*)	SLICE=${BOOTDISK}s ;;
esac
ESPDEV=${SLICE}0 ROOTDEV=${SLICE}1
[ "$(id -u)" = 0 ] || die "run me as root"
[ -c "/dev/$DISK" ] || die "no disk /dev/$DISK"
[ -f /boot/loader.efi ] && [ -f /boot/kernel/kernel ] ||
    die "this image has no /boot/loader.efi and /boot/kernel/kernel to install"
# Require a parseable character-device number even if ls itself fails.
device_number() {
	ls -ln "$1" 2>/dev/null | awk '
	    NR == 1 && $1 ~ /^c/ && $5 ~ /^[0-9]+,$/ &&
	    $6 ~ /^(0x[0-9a-fA-F]+|[0-9]+)$/ { print $5, $6; ok = 1 }
	    END { exit !ok }'
}
check_target() {
disks=$(sysctl -n kern.disks) || die "cannot list disks"
case " $disks " in
*" $DISK "*) ;;
*) die "/dev/$DISK is not a listed whole disk" ;;
esac
target_number=$(device_number "/dev/$DISK") || die "cannot inspect target disk"
target_info=$(diskinfo "/dev/$DISK") || die "cannot inspect target size"
case $target_info in *' blksize='*' offset='*' size='*) ;; *) die "cannot inspect target size" ;; esac
target_serial=
for path in /dev/serno/*; do
	[ -e "$path" ] || continue
	[ -c "$path" ] || die "cannot inspect serial alias $path"
	number=$(device_number "$path") || die "cannot inspect serial alias $path"
	[ "$number" = "$target_number" ] || continue
	[ -z "$target_serial" ] || die "target serial aliases are ambiguous"
	target_serial=${path#/dev/serno/}
done
disk_numbers=$target_number
for path in /dev/"$DISK"s[0-9]* /dev/"$DISK"[a-p]; do
	[ -e "$path" ] || continue
	[ -c "$path" ] || die "cannot inspect target device $path"
	number=$(device_number "$path") || die "cannot inspect target device $path"
	disk_numbers=$(printf '%s\n%s' "$disk_numbers" "$number")
done
layer_numbers=
for path in /dev/md[0-9]* /dev/vn[0-9]* /dev/ccd[0-9]* /dev/ar[0-9]* /dev/mapper/*; do
	[ -e "$path" ] || continue
	[ -c "$path" ] || die "cannot inspect layered device $path"
	number=$(device_number "$path") || die "cannot inspect layered device $path"
	layer_numbers=$(printf '%s\n%s' "$layer_numbers" "$number")
done
mounts=$(mount) || die "cannot inspect mounted filesystems"
swap=$(swapctl -l) || die "cannot inspect active swap"
swap_sources=$(printf '%s\n' "$swap" | awk '
    NR == 1 { if ($1 != "Device:") exit 1; next }
    NF != 3 { exit 1 }
    { print $1 }
    END { if (NR == 0) exit 1 }') || die "cannot parse active swap"
root=$(printf '%s\n' "$mounts" | sed -n 's|^\([^ ]*\) on / .*|\1|p')
root=${root#/dev/}
root=${root%%@*}
case $root in
"$DISK"|"$DISK"s[0-9]*|"$DISK"[a-p])
	die "/dev/$DISK holds the running system's root" ;;
esac
# devfs aliases, including slice-by-uuid and serno, name the same character
# device as the ordinary slice. Compare device numbers, not alias spelling.
# A root we cannot identify is not evidence that this disk is safe to erase.
case $root in ''|*[!A-Za-z0-9_./+-]*|*..*) die "cannot identify the running system's root device" ;; esac
[ -c "/dev/$root" ] || die "cannot identify the running system's root device"
rootmm=$(device_number "/dev/$root") || die "cannot identify the running system's root device"
if printf '%s\n' "$disk_numbers" | grep -Fxq "$rootmm"; then
	die "/dev/$DISK holds the running system's root"
fi
# Check mounted and swap character devices as well, including aliases.
# Refuse unrecognized sources instead of guessing their backing disks.
for source in $(printf '%s\n' "$mounts" | awk '$2 == "on" { print $1 }'; printf '%s\n' "$swap_sources"); do
	case $source in
	devfs|tmpfs|procfs|fdescfs|linprocfs|kernfs|autofs|pseudofs) continue ;;
	esac
	device=${source#/dev/}
	device=${device%%@*}
	case $device in ''|*[!A-Za-z0-9_./+-]*|*..*) die "cannot identify mounted source $source" ;; esac
	[ -c "/dev/$device" ] || die "cannot identify mounted source $source"
	mm=$(device_number "/dev/$device") || die "cannot inspect mounted device $source"
	# Layered devices can hide backing storage. Match device numbers so
	# that a devfs alias cannot bypass this conservative refusal.
	if printf '%s\n' "$layer_numbers" | grep -Fxq "$mm"; then
		die "cannot identify backing storage for mounted source $source"
	fi
	if printf '%s\n' "$disk_numbers" | grep -Fxq "$mm"; then
		die "/dev/$DISK is in use: $source is mounted or active swap"
	fi
done
}

check_target
reviewed_number=$target_number
reviewed_info=$target_info
reviewed_serial=$target_serial

msg "target: $reviewed_info"
msg "target serial alias: ${reviewed_serial:-unavailable}"

if [ -z "$YES" ]; then
	printf 'Erase all of /dev/%s and install FoxynBSD on it? [y/N] ' "$DISK"
	read -r answer
	case $answer in [yY]*) ;; *) die "nothing done" ;; esac
fi

# Recheck after the user has had time to review and confirm. Device numbers
# and sizes alone cannot prove identity after removal and replacement.
check_target
[ "$target_number" = "$reviewed_number" ] && [ "$target_info" = "$reviewed_info" ] &&
    [ "$target_serial" = "$reviewed_serial" ] ||
    die "target changed after confirmation; nothing was written"

# The partitions: the ESP first, the root in the rest of the disk.
msg "partitioning /dev/$DISK (GPT: ${ESPMB} MiB ESP, $FSTYPE root)"
gpt destroy "$DISK" >/dev/null 2>&1 || :
dd if=/dev/zero of="/dev/$DISK" bs=1m count=4 2>/dev/null
gpt create -f "$DISK"
gpt add -t efi -s $((ESPMB * 2048)) "$DISK" >/dev/null
gpt add -t "$FSTYPE" "$DISK" >/dev/null
# The table, with each slice's unique id (gpt show -g), the same id devfs
# names /dev/slice-by-uuid/<id> after, wherever the disk is found.
table=$(gpt show -g "$DISK")
printf '%s\n' "$table"
if [ -n "$BYUUID" ]; then
	u0=$(printf '%s\n' "$table" | awk '$4 == 0 && $5 == "GPT" { print tolower($NF) }')
	u1=$(printf '%s\n' "$table" | awk '$4 == 1 && $5 == "GPT" { print tolower($NF) }')
	if [ -n "$u0" ] && [ -n "$u1" ]; then
		ESPDEV=slice-by-uuid/$u0 ROOTDEV=slice-by-uuid/$u1
	fi
fi
# The kernel probes the new slices when the disk is next opened.
i=0
while [ ! -c "/dev/${DISK}s1" ]; do
	i=$((i + 1))
	[ $i -le 10 ] || die "/dev/${DISK}s0 and s1 did not appear"
	ls "/dev/$DISK" >/dev/null 2>&1
	sleep 1
done

msg "making the file systems"
# FAT32, as UEFI asks of an ESP; it needs at least 65525 clusters, so
# one-sector clusters for the small partition.
newfs_msdos -F 32 -c 1 -L EFI "/dev/${DISK}s0" >/dev/null
case $FSTYPE in
hammer2) newfs_hammer2 "/dev/${DISK}s1" >/dev/null ;;
ufs)	newfs "/dev/${DISK}s1" >/dev/null ;;
esac

# A mount point of its own: the live image's root is read-only.
MNT=$(mktemp -d /tmp/foxyn-install.XXXXXX)
mount -t "$FSTYPE" "/dev/${DISK}s1" "$MNT"
trap 'umount "$MNT/boot/efi" 2>/dev/null; umount "$MNT" 2>/dev/null; rmdir "$MNT"' EXIT

# The running system, as it is now: on root.iso /etc, /var and /root are
# the tmpfs copies (with the password databases already made).
msg "copying the system to /dev/${DISK}s1"
for d in bin boot etc lib libexec root sbin usr var; do
	[ -d "/$d" ] || continue
	cpdup -i0 -s0 -q "/$d" "$MNT/$d"
done
for d in dev mnt proc tmp home; do
	mkdir -p "$MNT/$d"
done
chmod 1777 "$MNT/tmp"
[ -d "$MNT/var/tmp" ] && chmod 1777 "$MNT/var/tmp"
rm -f "$MNT/var/db/boot-count"

# The live image's "installer" account (uid 0, no password, runs the BSD
# Installer) and the login banner that points at it belong to the live
# system only. Leaving them would give the installed system a root login
# without a password.
sed -i '' '/^installer:/d' "$MNT/etc/master.passwd" ||
    die "cannot remove the installer account"
[ ! -f "$MNT/etc/passwd" ] || sed -i '' '/^installer:/d' "$MNT/etc/passwd"
pwd_mkdb -p -d "$MNT/etc" "$MNT/etc/master.passwd" ||
    die "cannot rebuild the password databases"
printf 'Welcome to FoxynBSD!\n' > "$MNT/etc/issue"
if [ -n "$SETPW" ]; then
	printf '%s\n' "$ROOTPW" | pw -V "$MNT/etc" usermod root -h 0 ||
	    die "cannot set the root password"
	ROOTPW=
	msg "root password set"
else
	msg "WARNING: root has no password on the installed system (use -P)"
fi

# What differs from the live image: a read-write root on this disk.
# fsck checks a UFS root at boot; HAMMER2 needs no check.
pass=0
[ "$FSTYPE" = ufs ] && pass=1
cat > "$MNT/etc/fstab" <<EOF
# Device		Mountpoint	FStype	Options		Dump	Pass#
/dev/$ROOTDEV	/		$FSTYPE	rw		$pass	$pass
/dev/$ESPDEV	/boot/efi	msdos	rw,noauto	0	0
EOF
sed -i '' -e '/^root_rw_mount=/d' \
    -e 's|^# rc.conf for the .*|# rc.conf of a system installed by foxyn-install.  Services|' \
    "$MNT/etc/rc.conf"

# The ESP: the loader and its files, the kernel and the modules.
msg "installing the boot loader and the kernel"
mkdir -p "$MNT/boot/efi"
mount_msdos "/dev/${DISK}s0" "$MNT/boot/efi"
mkdir -p "$MNT/boot/efi/EFI/BOOT"
cp /boot/loader.efi "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI"
mkdir -p "$MNT/boot/efi/boot"
cpdup -i0 -s0 -q /boot "$MNT/boot/efi/boot"
rm -rf "$MNT/boot/efi/boot/efi" "$MNT/boot/efi/boot/loader.efi"
# The console the running system was booted with (comconsole or efi).
console=$(kenv console 2>/dev/null || echo efi)
{
	echo "console=\"$console\""
	[ "$console" = comconsole ] && echo 'boot_serial="YES"'
	echo 'autoboot_delay="3"'
	echo "vfs.root.mountfrom=\"$FSTYPE:$ROOTDEV\""
} > "$MNT/boot/efi/boot/loader.conf"
cp "$MNT/boot/efi/boot/loader.conf" "$MNT/boot/loader.conf"
umount "$MNT/boot/efi"
umount "$MNT"
rmdir "$MNT"
trap - EXIT
msg "done: /dev/$DISK boots FoxynBSD on its own ($FSTYPE root, $ROOTDEV when it boots)"
