.if exists (${.CURDIR}/../../Makefile.inc1)
LIBRESSL_SRC=	${.CURDIR}/../../crypto/libressl
.elif exists (${.CURDIR}/../../../Makefile.inc1)
LIBRESSL_SRC=	${.CURDIR}/../../../crypto/libressl
.else
.error "Cannot find base directory"
.endif
LCRYPTO_SRC=	${LIBRESSL_SRC}/crypto
LSSL_SRC=	${LIBRESSL_SRC}/ssl

CFLAGS+=	-I${LCRYPTO_SRC} -I${LSSL_SRC} -I${.OBJDIR}
CFLAGS+=	-I${LIBRESSL_SRC}/include

# The portable LibreSSL's compat headers: they declare and define what
# the system lacks (pledge, unveil, syslog_r, timespecsub, ...), as the
# HAVE_* settings below say.  These are what LibreSSL's configure finds
# for x86_64 DragonFly (see README.DRAGONFLY).
CFLAGS+=	-I${LIBRESSL_SRC}/include/compat
CFLAGS+=	-D__BEGIN_HIDDEN_DECLS= -D__END_HIDDEN_DECLS=
CFLAGS+=	-DHAVE_ENDIAN_H=1 -DHAVE_MACHINE_ENDIAN_H=1 -DHAVE_ERR_H=1
CFLAGS+=	-DHAVE_READPASSPHRASE_H=1 -DHAVE_NETINET_IP_H=1
CFLAGS+=	-DHAVE_NETINET_IN_H=1 -DHAVE_ARPA_NAMESER_H=1 -DHAVE_NETDB_H=1
CFLAGS+=	-DHAVE_RESOLV_H=1 -DHAVE_ASPRINTF=1 -DHAVE_FREEZERO=1
CFLAGS+=	-DHAVE_FTRUNCATE=1 -DHAVE_GETDELIM=1 -DHAVE_GETLINE=1
CFLAGS+=	-DHAVE_MEMMEM=1 -DHAVE_READPASSPHRASE=1 -DHAVE_REALLOCARRAY=1
CFLAGS+=	-DHAVE_RECALLOCARRAY=1 -DHAVE_STRCASECMP=1 -DHAVE_STRLCAT=1
CFLAGS+=	-DHAVE_STRLCPY=1 -DHAVE_STRNDUP=1 -DHAVE_STRNLEN=1
CFLAGS+=	-DHAVE_STRSEP=1 -DHAVE_STRTONUM=1 -DHAVE_TIMEGM=1
CFLAGS+=	-DHAVE_GETOPT=1 -DHAVE_GETPROGNAME=1 -DHAVE_SYSLOG=1
CFLAGS+=	-DHAVE_ACCEPT4=1 -DHAVE_POLL=1 -DHAVE_SOCKETPAIR=1
CFLAGS+=	-DHAVE_ARC4RANDOM=1 -DHAVE_ARC4RANDOM_BUF=1
CFLAGS+=	-DHAVE_ARC4RANDOM_UNIFORM=1 -DHAVE_EXPLICIT_BZERO=1
CFLAGS+=	-DHAVE_TIMINGSAFE_BCMP=1 -DHAVE_TIMINGSAFE_MEMCMP=1
CFLAGS+=	-DHAVE_DL_ITERATE_PHDR=1 -DHAVE_CLOCK_GETTIME=1
CFLAGS+=	-DHAVE_VA_COPY=1 -DHAVE___VA_COPY=1 -DHAS_GNU_WARNING_LONG=1
CFLAGS+=	-DSIZEOF_TIME_T=8
